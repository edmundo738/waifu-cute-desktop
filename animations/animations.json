{
  "schema": "waifu-cute-desktop/animation-spec/v1",
  "note": "Design specification only. No motion3.json/moc3 assets exist yet; rigging happens in Live2D Cubism Editor.",
  "priority_rules": [
    "talk and blink blend additively over any motion",
    "one full-body motion at a time: wave > think > surprised > wink > idle",
    "idle layer = idle_breathing + head_sway + hair_movement + (eye_movement | cursor_tracking)"
  ],
  "animations": [
    {"id": "idle_breathing", "parts": ["torso", "shoulders", "head", "jacket_sleeves"],
     "start": {"chest_scale": 1.0, "shoulder_y": 0.0, "param_angle_x": 0.0},
     "peak": {"chest_scale": 1.012, "shoulder_y_pct": 0.6, "param_angle_x": 0.4},
     "end": "same as start", "duration_s": 3.2, "loop": true,
     "trigger": "always (default idle)", "easing": "ease-in 1.4s / ease-out 1.8s"},
    {"id": "blink", "parts": ["eyelid_upper_L", "eyelid_upper_R", "eyelid_lower_L", "eyelid_lower_R"],
     "start": {"param_eye_l_open": 1, "param_eye_r_open": 1},
     "end": {"param_eye_l_open": 1, "param_eye_r_open": 1},
     "keyframes": [{"t": 0.0, "open": 1}, {"t": 0.08, "open": 0}, {"t": 0.10, "open": 0}, {"t": 0.25, "open": 1}],
     "duration_s": 0.25, "loop": false, "interval_s": [2.8, 5.2],
     "trigger": "idle timer; suppressed during surprised/wink"},
    {"id": "eye_movement", "parts": ["eyeball_L", "eyeball_R", "head_micro"],
     "start": "current gaze", "end": "random target within ±0.6",
     "saccade_s": [0.10, 0.14], "hold_s": [0.6, 2.4], "loop": true,
     "trigger": "idle; overridden by cursor_tracking"},
    {"id": "cursor_tracking", "parts": ["eyeball_L", "eyeball_R", "head", "torso"],
     "ranges": {"param_eye_ball_xy": [-1, 1], "param_angle_x": [-10, 10], "param_angle_y": [-8, 8], "param_angle_z": [-3, 3], "param_body_angle_x": [-2, 2]},
     "follow": {"lag_s": 0.12, "settle_s": 0.25, "damping": "critical", "head_share": 0.6},
     "release_after_rest_s": 1.5, "loop": false,
     "trigger": "pointermove events from Tauri window"},
    {"id": "head_sway", "parts": ["head", "neck"],
     "ranges": {"param_angle_z": [-2, 2], "param_angle_x": [-3, 3]},
     "frequencies_s": [4.5, 6.5], "loop": true, "trigger": "always (idle layer)"},
    {"id": "hair_movement", "parts": ["hair_front_tendrils", "hair_side_curls", "hair_puff", "earrings"],
     "ranges_deg": {"hair_front": 1.0, "hair_side": 0.8, "hair_back": 0.5, "earring_pendulum": 4},
     "phase_lag_s": {"front": 0.15, "side": 0.25, "back": 0.35, "earrings": 0.2},
     "implementation": "physics3.json simulation, not keyframes", "loop": true,
     "trigger": "any head/body motion + ambient ±0.2° at idle"},
    {"id": "smile", "parts": ["mouth", "cheeks", "eyelid_lower", "brows"],
     "start": {"param_mouth_form": 0}, "end": {"param_mouth_form": 0.6},
     "in_s": 0.4, "hold_s": 2.0, "out_s": 0.5, "loop": false,
     "trigger": "greeting, positive sentiment, compliment"},
    {"id": "talk", "parts": ["jaw", "mouth", "head_micro"],
     "visemes": ["A", "I", "U", "E", "O", "closed"], "viseme_ms": [80, 160], "blend_ms": 40,
     "params": {"param_mouth_open_y": [0, 1], "param_mouth_form": [-0.3, 0.3]},
     "loop": false, "trigger": "TTS phoneme stream during audio playback"},
    {"id": "wave", "parts": ["arm_R_upper", "arm_R_fore", "hand_R", "jacket_sleeve_R", "head", "mouth"],
     "phases": [{"name": "raise", "s": 0.5, "easing": "ease-out"},
                {"name": "oscillate", "s": 0.9, "hz": 2.2, "amplitude_deg": 14},
                {"name": "lower", "s": 0.55, "easing": "ease-in"}],
     "duration_s": 2.3, "loop": false,
     "trigger": "app launch, user return >5min, chat greeting"},
    {"id": "think", "parts": ["arm_R_fore", "hand_R", "eyeballs", "brow_inner", "mouth", "head"],
     "phases": [{"name": "hand_raise", "s": 0.6}, {"name": "gaze_shift", "s": 0.3},
                {"name": "hold", "s": "processing time, cap 6"}, {"name": "release", "s": 0.6}],
     "gaze": {"param_eye_ball_x": -0.5, "param_eye_ball_y": 0.5}, "head_tilt_deg": -3,
     "loop": false, "trigger": "long task, ambiguous query, hmm-line"},
    {"id": "surprised_reaction", "parts": ["brows", "eyes", "mouth", "head", "hands", "hair_puff"],
     "onset_s": 0.25, "hold_s": 0.8, "decay_s": 0.5,
     "values": {"param_brow_l_y": 0.8, "param_eye_open": 1.2, "param_mouth_open_y": 0.4,
                "param_angle_x": -3, "shoulder_rot_deg": 8, "puff_scale": 1.02},
     "duration_s": 1.55, "loop": false,
     "trigger": "unexpected notification, error event, easter egg"},
    {"id": "playful_wink", "parts": ["eyelid_L", "brow_L", "mouth", "head", "hand_R(optional)"],
     "phases": [{"name": "close", "s": 0.2}, {"name": "hold", "s": 0.35}, {"name": "open", "s": 0.25}],
     "values": {"param_eye_l_open": 0, "param_brow_l_y": 0.3, "param_mouth_form": 0.4, "head_tilt_deg": 5},
     "duration_s": 0.8, "loop": false,
     "trigger": "task completed, playful line, easter-egg hotkey"}
  ]
}
