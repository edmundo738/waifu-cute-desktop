{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Waifu Cute Desktop",
  "version": "0.1.0",
  "identifier": "com.waifucute.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Waifu Cute Desktop",
        "width": 480,
        "height": 720,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
